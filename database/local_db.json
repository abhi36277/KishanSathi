      "task_key": "rice_shallow_water",
      "task_title": "Maintain 2-3 cm Shallow Standing Water",
      "task_description": "Maintain thin water level across the paddy basins. Do not submerge tillers deeply as shallow water stimulates vigorous tiller emergence.",
      "reason": "Excess water depth inhibits tiller bud emergence; inadequate water induces weed competition.",
      "priority": "high",
      "due_date": "2026-11-05",
