# KisanSathi AI - Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase (Get from: https://supabase.com -> Project Settings -> API)
# If left empty, backend runs with high-performance in-memory demo store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Local MySQL Database (Direct connection to MySQL Server 8.4)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin123
MYSQL_DATABASE=kisansathi

# Google Gemini AI (Get from: https://aistudio.google.com/app/apikey)
# Tested with current Flash tier models: gemini-1.5-flash or gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
